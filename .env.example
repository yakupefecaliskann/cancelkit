# Supabase (docs/ARCHITECTURE.md #7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key used to encrypt customer Stripe restricted keys at rest (32 bytes, base64)
ENCRYPTION_KEY=

# Lemon Squeezy (our billing — Merchant of Record)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TEST ONLY — leave unset in real environments. Points every customer-Stripe
# call at a local mock (e.g. stripe-mock: http://localhost:12111) for e2e tests.
# STRIPE_API_BASE=

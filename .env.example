# Supabase (docs/ARCHITECTURE.md #7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key used to encrypt customer Stripe restricted keys at rest (32 bytes, base64)
ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TEST ONLY — leave unset in real environments. Points every customer-Stripe
# call at a local mock (e.g. stripe-mock: http://localhost:12111) for e2e tests.
# STRIPE_API_BASE=

# Sentry error tracking (optional — app runs fine with these unset, Sentry.init
# is a no-op without a DSN). NEXT_PUBLIC_SENTRY_DSN is used client-side, SENTRY_DSN
# server/edge-side; both come from the same Sentry project. SENTRY_ORG/PROJECT/
# AUTH_TOKEN are only needed to upload readable source maps on build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
